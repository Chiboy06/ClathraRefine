# Copy to .env.local (or pull with `vercel env pull .env.local`). Placeholders only.

# Convex (the production data store). Leave these empty to run on the in-memory demo store.
# The server key must match the Convex deployment variable: npx convex env set SERVER_KEY <same value>.
CONVEX_URL=
CONVEX_SERVER_KEY=
NEXT_PUBLIC_CONVEX_URL=
# Convex HTTP actions (telemetry ingest), used by the connect checklist.
NEXT_PUBLIC_CONVEX_SITE_URL=

# AWS (eu-west-1). Leave AWS_ROLE_ARN empty to run on the in-memory demo store.
AWS_REGION=eu-west-1
AWS_ROLE_ARN=
IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.eu-west-1.amazonaws.com
THING_NAME=ESP32S3-N16R8-HARNESS-01
# The board the dashboard watches; must equal THING_NAME.
NEXT_PUBLIC_THING_NAME=ESP32S3-N16R8-HARNESS-01
# AI keys live on the Convex deployment, not here: GEMINI_API_KEY and GROK_API_KEY (npx convex env set ...).
S3_UPLOAD_BUCKET=clathrarefine-archive-xx


# Clerk. Leave both empty to use demo quick-login (only when DEMO_AUTH=true).
# Add {"metadata":"{{user.public_metadata}}"} to the session token in the Clerk dashboard so roles and orgId
# reach the Next server without an extra user lookup; the server falls back to the user record if it is missing.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DEMO_AUTH=false
# Convex checks Clerk JWTs with this issuer (npx convex env set CLERK_JWT_ISSUER_DOMAIN ...).
CLERK_JWT_ISSUER_DOMAIN=
# svix signing secret for the Clerk user.updated webhook (npx convex env set CLERK_WEBHOOK_SECRET ...).
CLERK_WEBHOOK_SECRET=

# Shared key for the Convex telemetry ingest HTTP action (npx convex env set INGEST_KEY ...).
INGEST_KEY=

# Canonical origin for metadata, sitemap and Open Graph links.
NEXT_PUBLIC_SITE_URL=

# Base64 of the bcrypt hash of the supervisor PIN (base64 avoids dotenv "$" expansion). Generate:
# node -e "console.log(Buffer.from(require('bcryptjs').hashSync(process.argv[1],10)).toString('base64'))" YOURPIN
SUPERVISOR_PIN_HASH=

# Paystack test mode only
PAYSTACK_SECRET_KEY=
PAYSTACK_DEMO_SUBACCOUNT=
